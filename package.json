{
  "name": "ifsi-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Mini-vidéos motion design (TikTok / Reels / Shorts) pour les cours IFSI, générées en code avec Remotion",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "sfx": "python3 scripts/make-sfx.py",
    "sfx:import": "python3 scripts/import-sfx.py",
    "render:constantes": "remotion render Constantes out/02-constantes.mp4",
    "check:mascot": "esbuild scripts/qa/check-mascot.ts --bundle --platform=node --loader:.webp=empty --log-level=error --outfile=out/check-mascot.cjs && node out/check-mascot.cjs",
    "render:besoins": "remotion render Besoins-Fondamentaux out/03-besoins-fondamentaux.mp4",
    "render:fc": "remotion render Frequence-Cardiaque out/04-frequence-cardiaque.mp4",
    "voice": "python3 scripts/voice/tts_voix.py",
    "splice": "python3 scripts/qa/splice.py",
    "sheet": "bash scripts/qa/sheet.sh",
    "render:fr": "remotion render Frequence-Respiratoire out/05-frequence-respiratoire.mp4",
    "render:temp": "remotion render Temperature out/06-temperature.mp4",
    "render:ta": "remotion render Tension-Arterielle out/07-tension-arterielle.mp4",
    "render:gly": "remotion render Glycemie out/08-glycemie.mp4",
    "render:diu": "remotion render Diurese out/09-diurese.mp4",
    "render:avc": "remotion render AVC out/10-avc.mp4",
    "render:acr": "remotion render Arret-Cardiaque out/11-arret-cardiaque.mp4",
    "render:spo2": "remotion render SpO2 out/12-spo2.mp4",
    "render:ep": "remotion render Embolie-Pulmonaire out/14-embolie-pulmonaire.mp4",
    "render:avch": "remotion render AVC-Histoire out/15-avc-histoire.mp4",
    "render:plaies1": "remotion render Plaies-1 out/17-plaies-1.mp4",
    "render:plaies2": "remotion render Plaies-2 out/18-plaies-2.mp4",
    "render:plaies3": "remotion render Plaies-3 out/19-plaies-3.mp4",
    "render:bpco": "remotion render BPCO out/16-bpco.mp4",
    "cues": "python3 scripts/voice/cues.py",
    "check:voice": "python3 scripts/voice/check_lang.py",
    "qa": "bash scripts/qa/qa.sh",
    "new": "python3 scripts/new-video.py",
    "render:prise-de-sang": "remotion render Prise-De-Sang out/20-prise-de-sang.mp4",
    "render:hygiene-mains": "remotion render Hygiene-Mains out/21-hygiene-mains.mp4",
    "render:precautions-standard": "remotion render Precautions-Standard out/22-precautions-standard.mp4",
    "render:insuffisance-cardiaque": "remotion render Insuffisance-Cardiaque out/23-insuffisance-cardiaque.mp4",
    "render:douleur-1": "remotion render Douleur-1 out/24-douleur-1.mp4",
    "render:douleur-2": "remotion render Douleur-2 out/25-douleur-2.mp4",
    "render:quiz-constantes": "remotion render Quiz-Constantes out/27-quiz-constantes.mp4",
    "render:diabete-1": "remotion render Diabete-1 out/26-diabete-1.mp4",
    "render:diabete-2": "remotion render Diabete-2 out/26-diabete-2.mp4",
    "render:constantes-enfant": "remotion render Constantes-Enfant out/28-constantes-enfant.mp4",
    "render:suppositoire": "remotion render Suppositoire out/29-suppositoire.mp4",
    "render:objet-plante": "remotion render Objet-Plante out/30-objet-plante.mp4",
    "render:plaie-profondeur": "remotion render Plaie-Profondeur out/31-plaie-profondeur.mp4",
    "render:plaie-contuse": "remotion render Plaie-Contuse out/32-plaie-contuse.mp4",
    "render:plaie-piqure": "remotion render Plaie-Piqure out/33-plaie-piqure.mp4",
    "render:plaie-morsure": "remotion render Plaie-Morsure out/34-plaie-morsure.mp4",
    "render:plaie-chronique": "remotion render Plaie-Chronique out/35-plaie-chronique.mp4",
    "render:escarre": "remotion render Escarre out/36-escarre.mp4",
    "render:pied-diabetique": "remotion render Pied-Diabetique out/37-pied-diabetique.mp4",
    "render:trousse-secours": "remotion render Trousse-Secours out/38-trousse-secours.mp4",
    "render:pansement": "remotion render Pansement out/39-pansement.mp4",
    "render:brulure": "remotion render Brulure out/40-brulure.mp4",
    "render:echarde": "remotion render Echarde out/41-echarde.mp4",
    "render:tique": "remotion render Tique out/42-tique.mp4",
    "render:saignement-nez": "remotion render Saignement-Nez out/43-saignement-nez.mp4",
    "render:piqure-abeille": "remotion render Piqure-Abeille out/44-piqure-abeille.mp4",
    "render:entorse": "remotion render Entorse out/45-entorse.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "@remotion/effects": "4.0.532",
    "@remotion/fonts": "^4.0.532",
    "@remotion/motion-blur": "4.0.532",
    "@remotion/transitions": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
